---
import skillsData from "../data/skills.json";
import SkillsCard from "./SkillsCard.astro";

const { size = "default" } = Astro.props;

const isSmall = size === "small";
---

<div class="grid grid-cols-1 lg:grid-cols-3 w-full gap-6">
  {
    skillsData.map((skill, index) => (
      <SkillsCard title={skill.title} index={index + 1} size={size}>
        <div class={`flex flex-wrap ${isSmall ? "gap-1.5" : "gap-2"}`}>
          {skill.techs.map((tech) => (
            <span
              class={`
    inline-flex items-center
    rounded-full
    font-medium
    ${isSmall ? "text-xs px-2 py-0.5" : "text-xs md:text-sm px-3 py-1"}
    bg-light-blue/20
    text-dark-blue
    border border-light-blue/40
    shadow-sm
  `}
            >
              {tech}
            </span>
          ))}
        </div>
      </SkillsCard>
    ))
  }
</div>
