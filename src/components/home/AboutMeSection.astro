---
import CustomLink from "../CustomLink.astro";
import aboutData from "../../data/about.json";
import Title from "../Title.astro";
import Skills from "../Skills.astro";
---

<div
  class="section-scroll flex flex-col items-center justify-center md:px-[20vw] md:h-screen lg:px-[20vw] px-6 relative min-h-fit"
>
  <Title title="About" className="lg:text-5xl md:text-4xl text-3xl" />
  <p class="mt-10 mb-10 md:text-base text-sm font-light">
    Hello! I’m Carissa Fabellina, an aspiring Data Engineer who loves turning
    raw data into reliable, well-structured systems. I enjoy working on data
    pipelines, automation, and performance optimization, and I’m always eager to
    learn new technologies in the data ecosystem. I also care deeply about
    design. I believe that good engineering shouldn’t stop at functionality—how
    something looks and feels matters too. That’s why I enjoy combining
    technical problem-solving with a design-driven mindset to build solutions
    that are both powerful and pleasant to use.
  </p>

  <div class="w-full flex flex-col gap-3 mb-10">
    {
      aboutData.experience.slice(0, 2).map((experience) => {
        return (
          <div class="flex md:flex-row flex-col justify-between w-full">
            <div>
              <h4 class="font-bold md:text-base text-sm">
                {experience.position}
              </h4>
              <h4 class="font-medium opacity-50 text-sm">{experience.where}</h4>
            </div>

            <div class="opacity-50 md:text-base text-xs">{experience.date}</div>
          </div>
        );
      })
    }
  </div>

  <Skills size="small" />

  <CustomLink
    link="/about"
    text="Learn More About Me"
    className="mt-10 mb-4 self-end"
  />
</div>
