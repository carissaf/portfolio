---
import CustomButton from "../DownloadCVButton.astro";
import ArrowDownIcon from "../icons/ArrowDownIcon.astro";
import GitHubIcon from "../icons/GitHubIcon.astro";
import InstagramIcon from "../icons/InstagramIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
---

<div
  class="hero section-scroll flex flex-col w-full items-center justify-center h-screen md:px-[7vw] px-6 relative opacity-0 transform -translate-y-5 transition-all duration-[1500ms] ease-in-out min-h-fit"
>
  <div class="flex flex-col justify-center w-full">
    <h1 class="text-5xl md:text-6xl font-medium">Carissa Fabellina</h1>
    <p class="font-light md:text-lg mt-2 mb-8">
      an aspiring Data Engineer passionate about data, engineering, and clean,
      thoughtful design :>
    </p>

    <div class="flex flex-wrap gap-4 items-center">
      <CustomButton text="Download CV" className="w-fit" />
      <a href="https://www.linkedin.com/in/carissafabellina/" target="_blank">
        <LinkedInIcon className="md:w-8 w-7" />
      </a>

      <a href="https://github.com/carissaf" target="_blank">
        <GitHubIcon className="md:w-8 w-7" />
      </a>

      <a href="https://www.instagram.com/cariss.aa/" target="_blank">
        <InstagramIcon className="md:w-8 w-7" />
      </a>
    </div>
  </div>

  <ArrowDownIcon
    className="w-7 md:w-10 absolute bottom-32 animate-bounce-slow"
  />
</div>

<script>
  window.addEventListener("DOMContentLoaded", function () {
    const navbar = document.querySelector(".hero");
    navbar.classList.remove("opacity-0", "-translate-y-5");
    navbar.classList.add("opacity-1", "translate-y-0");
  });
</script>
